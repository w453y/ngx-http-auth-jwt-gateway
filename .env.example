# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# Express session secret - generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-here

# ==========================================
# Google OAuth Configuration
# ==========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://auth.example.com/auth/google/callback

# ==========================================
# User Subsets Configuration
# ==========================================
# Define subset names (comma-separated)
SUBSETS=admin,user

# Define emails for each subset
SUBSET_admin_EMAILS=admin@company.com
SUBSET_user_EMAILS=user1@company.com,user2@company.com

# Define which cookies to set for each subset
SUBSET_admin_COOKIES=auth-token
SUBSET_user_COOKIES=auth-token

# ==========================================
# JWT Configuration
# ==========================================
# Generate JWT secret with: openssl rand -hex 32
# IMPORTANT: Use the SAME hex value in nginx.conf auth_jwt_key directive

# Default JWT settings (used when cookie-specific not set)
JWT_DEFAULT_SECRET=your-default-jwt-secret-hex
JWT_DEFAULT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRES=24h
JWT_DEFAULT_DOMAIN=.example.com

# Cookie-specific JWT settings
# Note: Replace hyphens with underscores in cookie names
# Example: auth-token becomes auth_token

# JWT settings for 'auth-token' cookie
JWT_SECRET_auth_token=your-hex-secret-from-openssl-rand
JWT_ALGORITHM_auth_token=HS256
JWT_EXPIRES_auth_token=24h
JWT_DOMAIN_auth_token=.example.com
JWT_PATH_auth_token=/
JWT_HTTPONLY_auth_token=true
JWT_MAXAGE_auth_token=86400000
JWT_SAMESITE_auth_token=lax

# Optional: Additional JWT claims (key:value,key2:value2)
# JWT_CLAIMS_auth_token=role:user,app:main

# ==========================================
# Additional JWT Cookie Examples
# ==========================================
# Uncomment and configure if you use multiple cookies

# JWT settings for 'admin-token' cookie
# JWT_SECRET_admin_token=another-hex-secret-here
# JWT_ALGORITHM_admin_token=HS256
# JWT_EXPIRES_admin_token=4h
# JWT_DOMAIN_admin_token=.example.com
# JWT_CLAIMS_admin_token=role:admin

# ==========================================
# Notes
# ==========================================
# 1. Generate secrets with: openssl rand -hex 32 (for HS256)
# 2. Use the SAME JWT secret in nginx.conf auth_jwt_key
# 3. Replace example.com with your actual domain
# 4. In production, always use HTTPS
# 5. Keep .env file secure and never commit it to git
