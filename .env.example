# ============================================
# Auth JWT Gateway Configuration
# ============================================
# Copy this file to .env and configure your settings

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# Session secret - REQUIRED, change this in production!
SESSION_SECRET=your-super-secret-session-key-change-me

# Note: Rate limiting is enabled by default
# - Auth endpoints: 20 requests per 15 minutes
# - General endpoints: 100 requests per 15 minutes

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The callback URL - update with your domain
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ============================================
# Subset Configuration
# ============================================
# Define your subsets (comma-separated)
SUBSETS=A,B

# Emails for each subset (comma-separated)
SUBSET_A_EMAILS=admin@example.com,user1@example.com
SUBSET_B_EMAILS=user2@example.com,user3@example.com

# ============================================
# Cookie Configuration per Subset
# ============================================
# Define which cookies each subset should receive
SUBSET_A_COOKIES=auth-token
SUBSET_B_COOKIES=auth-token,admin-token

# ============================================
# JWT Configuration per Cookie
# ============================================
# Note: Use underscores instead of hyphens in env var names
# e.g., for "auth-token" cookie, use "auth_token" in env var names

# Default JWT secret (used if no specific secret is set)
JWT_DEFAULT_SECRET=your-default-jwt-secret-change-me

# Default JWT settings
JWT_DEFAULT_ALGORITHM=HS256
JWT_DEFAULT_EXPIRES=24h
JWT_DEFAULT_DOMAIN=

# Specific configuration for auth-token cookie
JWT_SECRET_auth_token=your-auth-token-secret
JWT_ALGORITHM_auth_token=HS256
JWT_EXPIRES_auth_token=24h
JWT_DOMAIN_auth_token=.example.com
JWT_PATH_auth_token=/
JWT_HTTPONLY_auth_token=true
JWT_MAXAGE_auth_token=86400000
JWT_SAMESITE_auth_token=lax
JWT_CLAIMS_auth_token=type:access

# Specific configuration for admin-token cookie
JWT_SECRET_admin_token=your-admin-token-secret
JWT_ALGORITHM_admin_token=HS256
JWT_EXPIRES_admin_token=12h
JWT_DOMAIN_admin_token=.example.com
JWT_PATH_admin_token=/
JWT_HTTPONLY_admin_token=true
JWT_MAXAGE_admin_token=43200000
JWT_SAMESITE_admin_token=strict
JWT_CLAIMS_admin_token=role:admin,type:admin-access

# ============================================
# Example: Adding a third subset (C)
# ============================================
# To add subset C, update SUBSETS and add these:
# SUBSETS=A,B,C
# SUBSET_C_EMAILS=poweruser@example.com
# SUBSET_C_COOKIES=auth-token,super-token
# JWT_SECRET_super_token=your-super-token-secret
# JWT_CLAIMS_super_token=role:superuser
